{
	"autoStart": false,
	"servers": {
		"csharp": {
			"command": "csharp-language-server",
			"args": [],
			"rootMarkers": ["*.sln", "*.csproj", "global.json"],
			"enabled": true
		},
		"_comment_csharp_alternative": "Alternative: OmniSharp — use { \"command\": \"OmniSharp\", \"args\": [\"-lsp\"] } (download from https://github.com/OmniSharp/omnisharp-roslyn/releases)",
		"python": {
			"command": "pylsp",
			"args": [],
			"rootMarkers": ["pyproject.toml", "requirements.txt", "setup.py", ".git"],
			"enabled": true
		},
		"typescript": {
			"command": "typescript-language-server",
			"args": ["--stdio"],
			"rootMarkers": ["tsconfig.json", "package.json", "jsconfig.json"],
			"enabled": true
		},
		"javascript": {
			"command": "typescript-language-server",
			"args": ["--stdio"],
			"rootMarkers": ["package.json", "jsconfig.json", "tsconfig.json", ".git"],
			"enabled": true
		},
		"bash": {
			"command": "bash-language-server",
			"args": ["start"],
			"rootMarkers": [".shellcheckrc", ".git"],
			"enabled": true
		},
		"shell": {
			"command": "bash-language-server",
			"args": ["start"],
			"rootMarkers": [".shellcheckrc", ".git"],
			"enabled": true
		},
		"lua": {
			"command": "lua-language-server",
			"args": [],
			"rootMarkers": [".luarc.json", ".luarc.jsonc", ".luacheckrc", "stylua.toml", ".stylua.toml", ".git"],
			"enabled": true
		},
		"powershell": {
			"command": "powershell-editor-services",
			"args": ["-Stdio"],
			"rootMarkers": ["*.psd1", ".git"],
			"enabled": true
		},
		"sql": {
			"command": "sql-language-server",
			"args": ["up", "--method", "stdio"],
			"rootMarkers": [".sqllsrc.json", "sqls.yml", ".sqlfluff", ".sqruff", "*.sqlproj", ".git"],
			"enabled": true
		},
		"_comment_sql_alternative": "Alternatives: sqls — { \"command\": \"sqls\", \"args\": [] } or sqruff — { \"command\": \"sqruff\", \"args\": [\"lsp\"] }",
		"postgres": {
			"command": "postgres-language-server",
			"args": ["lsp-proxy"],
			"rootMarkers": ["postgres-language-server.jsonc", "postgrestools.jsonc", ".sqllsrc.json", ".sqlfluff", ".git"],
			"enabled": true
		},
		"sqlserver": {
			"command": "sql-language-server",
			"args": ["up", "--method", "stdio"],
			"rootMarkers": [".sqllsrc.json", "sqls.yml", ".sqlfluff", ".sqruff", "*.sqlproj", ".git"],
			"enabled": true
		},
		"_comment_sqlserver_alternative": "Alternatives for T-SQL: sqls (with driver: mssql in sqls.yml) — { \"command\": \"sqls\", \"args\": [] } or sqruff (with dialect = tsql in .sqruff) — { \"command\": \"sqruff\", \"args\": [\"lsp\"] }"
	}
}
