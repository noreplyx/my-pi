{
  "mcpServers": {
    "ado": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "@azure-devops/mcp",
        "gcad-cls",
        "-d",
        "all",
        "-a",
        "interactive"
      ],
      "env": {
        "NODE_USE_SYSTEM_CA": "1",
        "NODE_OPTIONS": "--use-system-ca",
        "NPM_CONFIG_UPDATE_NOTIFIER": "false",
        "NPM_CONFIG_FUND": "false",
        "NPM_CONFIG_AUDIT": "false"
      },
      "description": "Azure DevOps MCP server for projects, repos, PRs, work items, pipelines, wiki, and search",
      "exposure": "codemode",
      "timeout": 30
    }
  }
}
